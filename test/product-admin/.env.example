# 이 파일을 복사해 .env.local을 만들고 값을 채운다. .env.local은 git에 올라가지 않는다.
# 값 위치: Supabase 대시보드 > Project Settings > API
# Session Pooler 주소(postgres://...)는 쓰지 않는다.
SUPABASE_URL=https://프로젝트ID.supabase.co
# 조회에 쓰는 키
SUPABASE_ANON_KEY=
# 삭제에 쓰는 키. RLS를 무시하므로 다른 사람에게 공유하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
# 사이트에서 상품을 삭제할 때 입력하는 비밀번호. 비워 두면 삭제가 막힌다.
ADMIN_PASSWORD=
