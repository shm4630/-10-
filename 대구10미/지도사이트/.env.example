# 이 파일을 복사해 .env.local을 만들고 값을 채운다. .env.local은 git에 올라가지 않는다.
# 값 위치: Supabase 대시보드 > Project Settings > API

# 브라우저에서 쓰는 값 (공개되어도 되는 값)
VITE_SUPABASE_URL=https://프로젝트ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# 아래는 서버에서만 쓰는 비밀 값. VITE_ 접두사를 붙이지 않는다.
# 구획과 식당을 저장할 때 쓰는 키. RLS를 무시하므로 다른 사람에게 공유하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
# 공공데이터포털 소상공인시장진흥공단 상가(상권)정보 일반 인증키
DATA_GO_KR_KEY=
# 구획을 만들 때 입력하는 비밀번호. 비워 두면 구획 생성이 막힌다.
ADMIN_PASSWORD=
# 식당 필터링과 자연어 검색에 쓰는 키. 비워 두면 업종 코드와 단어 일치로만 동작한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
